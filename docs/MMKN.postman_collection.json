{
  "info": {
    "name": "MMKN full demo — run on a fresh server",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Service dictionary: integer IDs",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/services"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Integer IDs',()=>Object.values(pm.response.json()).flat().forEach(s=>pm.expect(Number.isInteger(s.id)).to.eql(true)));",
              "pm.test('Service shape and icon URLs', () => { const catalog = pm.response.json(); for (const [category, services] of Object.entries(catalog)) for (const service of services) { pm.expect(service).to.have.all.keys('id','name','available','iconUrl'); pm.expect(service.iconUrl).to.eql('/icons/' + category + '.svg'); } });",
              "for (const [category, services] of Object.entries(pm.response.json())) pm.collectionVariables.set(category + 'Icon', services[0].iconUrl);"
            ]
          }
        }
      ]
    },
    {
      "name": "electricity icon from the catalog URL",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}{{electricityIcon}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('SVG content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('image/svg+xml'));",
              "pm.test('SVG image content', () => pm.expect(pm.response.text()).to.include('<svg'));"
            ]
          }
        }
      ]
    },
